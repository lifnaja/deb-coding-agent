# Copy this file to airflow/.env before starting Docker Compose.
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Generate a Fernet key for non-demo environments. The default is suitable only
# for local development and is intentionally not committed as a real secret.
FERNET_KEY=

# Local-only Airflow web login.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Keep empty unless you deliberately need an extra Python package for a quick
# local check. Build a custom Airflow image for repeatable dependencies.
_PIP_ADDITIONAL_REQUIREMENTS=
